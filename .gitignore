# Local configuration and secrets
.env
.env.*
!.env.example

# Python environments, caches and generated bytecode
.venv/
**/.venv/
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Runtime state, logs and local databases
runtime/
logs/
acceptance/
backups/
data/*.db
data/*.db-*
data/*.jsonl
demo/
.bootstrap-contract
*.sqlite3
*.sqlite3-*
*.orig

# Downloaded model/cache data and runtime weights are provisioned outside Git.
models/
*.pth
*.index
*.pt
*.onnx

# The headless RVC runtime is provisioned as a release asset, never committed
# as a nested development checkout. Keep it on the deployment volume.
vendor/rvc/
