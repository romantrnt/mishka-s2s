## User-facing candidate mode. Use MISHKA_PROFILE=mock only for offline tests.
MISHKA_PROFILE=production_candidate
MISHKA_POLICY_VERSION=mishka-deployment/v1
STAND_ACCESS_TOKEN=
MISHKA_ALLOW_QUERY_TOKEN=0
NO_VOICE_RECORDING=true
MISHKA_CONTENT_ROOT=content
MISHKA_HOST=0.0.0.0
MISHKA_PORT=8000
MISHKA_PROFILE_DB=/workspace/.data/mishka/profiles.sqlite3
# Production button 7 provider: Yandex Weather REST API (RU endpoint).
YANDEX_WEATHER_API_KEY=
YANDEX_WEATHER_LATITUDE=
YANDEX_WEATHER_LONGITUDE=
YANDEX_WEATHER_TIMEOUT_S=2.0
INTENT_CONFIDENCE_THRESHOLD=0.6
MISHKA_MAX_SESSION_SECONDS=1200
MISHKA_SESSION_IDLE_TTL_SECONDS=300
MISHKA_WATCHDOG_INTERVAL_SECONDS=5
MISHKA_WATCHDOG_STALE_AFTER_SECONDS=30
MISHKA_WATCHDOG_COOLDOWN_SECONDS=30
MISHKA_AUDIO_CLEANUP_TIMEOUT_SECONDS=1.0
MISHKA_WARMUP_E2E_TIMEOUT_S=90
MISHKA_WARMUP_E2E_STAGE_TIMEOUT_S=20
MISHKA_WARMUP_PCM_PATH=assets/reference/mishka_24k_mono.wav
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_FORMAT=float32
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=225
VAD_CONTINUE_THRESHOLD=0.20
VAD_PREROLL_MS=320
MISHKA_VAD_DEVICE=cpu
MIN_SPEECH_MS=300
MAX_SPEECH_MS=12000
MAX_AUDIO_BUFFER_SECONDS=15
STT_CONFIDENCE_THRESHOLD=0.45
STT_BEAM_SIZE=3
STT_TIMEOUT_SECONDS=8
LLM_TIMEOUT_SECONDS=10
LLM_WARMUP_TIMEOUT_SECONDS=120
TTS_TIMEOUT_SECONDS=10
RVC_TIMEOUT_SECONDS=45
RVC_STARTUP_TIMEOUT_SECONDS=60
PLAYBACK_TIMEOUT_SECONDS=60
MAX_INPUT_CHARS=512
MAX_RESPONSE_CHARS=320
MAX_TTS_CHUNK_CHARS=72
MAX_TTS_FIRST_CHUNK_CHARS=12
TTS_QUEUE_SIZE=4
TTS_QUEUE_PUT_TIMEOUT_SECONDS=2
LLM_PROVIDER=ollama
# Verified official Ollama tag as of 2026-09-22; keep configurable.
LLM_MODEL=qwen3:14b
LLM_QUANTIZATION=Q4_K_M
LLM_CONTEXT_LENGTH=32768
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=96
LLM_KEEP_ALIVE=-1
LLM_THINK=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
VLLM_BASE_URL=http://127.0.0.1:8001
WHISPER_MODEL=large-v3-turbo
SILERO_MODEL=v5_5_ru
SILERO_LANGUAGE=ru
SILERO_SPEAKER=aidar
SILERO_SAMPLE_RATE=48000
SILERO_CACHE_PATH=/workspace/.cache/mishka/silero/v5_5_ru.pt
SILERO_LEADING_SILENCE_MS=150
RVC_PROJECT_ROOT=vendor/rvc
RVC_PYTHON=vendor/rvc/.venv/bin/python
RVC_MODEL=models/rvc/mishka_rvc_v2_e250_2250s.pth
RVC_INDEX=models/rvc/mishka_rvc_v2_e250_2250s.index
RVC_F0_METHOD=rmvpe
RVC_F0_UP_KEY=0
RVC_FILTER_RADIUS=3
RVC_INDEX_RATE=0.0
RVC_PROTECT=0.33
RVC_TMP_DIR=/workspace/.cache/mishka/rvc-tmp
# Production is fail-closed: Silero output must pass through the trained RVC voice.
RVC_FALLBACK_MODE=fail_closed
FAST_AUDIO_ACK=false
FAST_AUDIO_ACK_COOLDOWN_S=4
MIN_AVAILABLE_RAM_GB=12
MIN_AVAILABLE_VRAM_GB=8
MISHKA_VOICE_CONVERSION=rvc_v2
# Set only after selecting a real local output device.
# AUDIO_OUTPUT_DEVICE=
MISHKA_SCENARIO_ENGINE=langgraph
MISHKA_LANGGRAPH_STRICT=1
AUDIO_OUTPUT_DEVICE=
# Async safety gate. Mock is valid only for the mock profile; production_candidate requires ollama.
VALIDATION_PROVIDER=ollama
VALIDATION_MODEL=qwen3:0.6b
VALIDATION_TIMEOUT_MS=10000
VALIDATION_KEEP_ALIVE=-1
VALIDATION_NUM_CTX=1024
VALIDATION_FAIL_CLOSED=1
MISHKA_MAX_TURN_SECONDS=60
MAX_TTS_QUEUE_BYTES=262144
MAX_TTS_CHUNKS_PER_GENERATION=32
MAX_HISTORY_ENTRIES=20
MAX_HISTORY_CHARS=8192
OBSERVABILITY_LATENCY_LIMIT=500
OBSERVABILITY_EVENT_LIMIT=500
OBSERVABILITY_WATCHDOG_LIMIT=200
